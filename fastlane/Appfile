# Appfile — identifies the app & Apple accounts Fastlane talks to.
# Values come from app.json (ios.bundleIdentifier) and your Apple Developer account.
#
# In CI we authenticate with an App Store Connect API Key (see Fastfile), so we
# do NOT hard-code an Apple ID password here. The values below are read from
# environment variables so nothing sensitive is committed to git.

app_identifier(ENV["APP_IDENTIFIER"] || "com.spontani.app") # The bundle identifier of your app

# Your App Store Connect Team ID (a number like "118XXXXX").
# Find it: App Store Connect → top-right account menu → it's in the URL / membership.
itc_team_id(ENV["APP_STORE_CONNECT_TEAM_ID"]) if ENV["APP_STORE_CONNECT_TEAM_ID"]

# Your Apple Developer Portal Team ID (10-char string like "AB12CD34EF").
# Find it: https://developer.apple.com/account → Membership details.
team_id(ENV["APPLE_TEAM_ID"]) if ENV["APPLE_TEAM_ID"]
