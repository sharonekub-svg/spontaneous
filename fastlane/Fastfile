# Fastfile — iOS build & App Store Connect delivery for Spontani (Expo managed RN).
#
# Because this is an Expo *managed* app, there is no committed `ios/` folder.
# The GitHub Actions workflow runs `expo prebuild` first to generate it, then
# calls these lanes. Authentication everywhere uses an App Store Connect API Key
# (.p8) — no Apple ID / 2FA, which is the only reliable way to auth from CI.
#
# Lanes:
#   beta        → build a signed Release IPA and upload to TestFlight   (CI default)
#   release     → build + submit to App Store review (manual / on demand)
#   promote     → promote the latest TestFlight build to App Store review (no rebuild)

default_platform(:ios)

# Path to the generated Xcode workspace/scheme. `expo prebuild` names the project
# after the app's display name ("Spontani"). Override via env if yours differs.
WORKSPACE = ENV["IOS_WORKSPACE"] || "ios/Spontani.xcworkspace"
SCHEME    = ENV["IOS_SCHEME"]    || "Spontani"

platform :ios do
  # ---- shared helpers -------------------------------------------------------

  # Builds an App Store Connect API token from the three secrets injected by CI.
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"], # base64-encoded contents of the .p8 file
      is_key_content_base64: true,
      in_house: false
    )
  end

  # Installs the App Store distribution cert + profile via Match (read-only).
  def install_signing(api_key)
    match(
      type: "appstore",
      readonly: true,
      api_key: api_key
    )
  end

  # Compiles a signed Release .ipa.
  def build(api_key)
    install_signing(api_key)
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "Spontani.ipa",
      xcargs: "-allowProvisioningUpdates"
    )
  end

  # ---- lanes ----------------------------------------------------------------

  desc "Build and upload a new build to TestFlight"
  lane :beta do
    api_key = asc_api_key
    build(api_key)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true, # don't burn CI minutes waiting on Apple
      distribute_external: false               # internal testers only by default
    )
  end

  desc "Build and submit to App Store review (production)"
  lane :release do
    api_key = asc_api_key
    build(api_key)
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,                # you tap "Release" in App Store Connect
      force: true,                             # skip the HTML preview/confirm
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false           # set true + details if you use IDFA
      }
    )
  end

  desc "Promote the latest TestFlight build to App Store review (no rebuild)"
  lane :promote do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      build_number: ENV["BUILD_NUMBER"],       # optional: pin a specific build
      skip_binary_upload: true,                # reuse the existing TestFlight binary
      submit_for_review: true,
      automatic_release: false,
      force: true
    )
  end
end
