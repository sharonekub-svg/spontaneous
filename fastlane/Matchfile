# Matchfile — Fastlane Match config for code-signing in CI.
#
# Match stores your iOS signing certificates + provisioning profiles in a
# SEPARATE, PRIVATE git repo, encrypted with MATCH_PASSWORD. CI clones that repo,
# decrypts, and installs the identities — so the macOS runner can sign without
# you ever copying .p12 / .mobileprovision files around by hand.
#
# One-time local setup (run on your Mac, NOT in CI):
#   1. Create an EMPTY private repo, e.g. github.com/sharonekub-svg/spontani-certs
#   2. From this project run:  bundle exec fastlane match appstore
#      → it generates the distribution cert + App Store profile and pushes them
#        (encrypted) to that repo.
#
# All values are read from env vars so nothing secret is committed here.

git_url(ENV["MATCH_GIT_URL"])        # e.g. https://github.com/sharonekub-svg/spontani-certs.git
storage_mode("git")

type("appstore")                     # distribution profile for TestFlight / App Store
app_identifier([ENV["APP_IDENTIFIER"] || "com.spontani.app"])

# In CI we must NOT be prompted, and Match should only READ existing identities
# (never try to create/regenerate them on a throwaway runner).
readonly(true)
