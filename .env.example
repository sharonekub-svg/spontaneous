# ---------------------------------------------------------------------------
# Spontani environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.
# Variables prefixed with EXPO_PUBLIC_ are embedded in the client bundle and
# are therefore safe to expose (publishable keys only — never service keys).
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (safe for the client)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth web client id (used by expo-auth-session for Google sign-in)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Server-only (used by migrations / seed scripts / CI — DO NOT prefix EXPO_PUBLIC_)
# ---------------------------------------------------------------------------

# Direct Postgres connection string for running seed scripts locally
SUPABASE_DB_URL=

# Supabase service role key — server side only, used by CI and admin tooling
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project ref (for `supabase link` in CI)
SUPABASE_PROJECT_REF=

# Supabase access token (for the Supabase CLI in CI)
SUPABASE_ACCESS_TOKEN=
