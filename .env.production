# Production environment for web builds (Vercel reads this at build time).
# EXPO_PUBLIC_* values are embedded in the client bundle, so they must be
# public-safe. The anon key below is the public Supabase client key — it is
# meant to ship to clients and is protected by Row Level Security.
# NEVER put the service_role key or DB password here.
EXPO_PUBLIC_SUPABASE_URL=https://zceoswqrvcqmjjohpeyo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpjZW9zd3FydmNxbWpqb2hwZXlvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI2MzI5NTQsImV4cCI6MjA5ODIwODk1NH0.cEexMPquVc08EdX8sZqYRjate1g_MOkk08_MXVEwl5k
EXPO_PUBLIC_SENTRY_DSN=
